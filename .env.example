# .env.example — Neuriy ChatBase integration
FEATURE_MARKETPLACE=true
FEATURE_MARKETPLACE_AI_TOOLS=true

NEURIY_MARKETPLACE_URL=http://127.0.0.1:8000
NEURIY_MARKETPLACE_STORE_URL=http://127.0.0.1:5011
NEURIY_MARKETPLACE_TIMEOUT_MS=8000

MARKETPLACE_CACHE_TTL_LIST_SEC=60
MARKETPLACE_CACHE_TTL_ITEM_SEC=120
MARKETPLACE_CACHE_TTL_CATEGORIES_SEC=300
MARKETPLACE_CACHE_TTL_HEALTH_SEC=30
MARKETPLACE_CONTEXT_BUDGET_CHARS=4000
MARKETPLACE_TOOL_RATE_LIMIT_PER_MINUTE=30

ELLOFIVE_URL=http://127.0.0.1:3999
ELLOFIVE_MODEL=ellofive
ELLOFIVE_TIMEOUT_MS=60000
# Optional real Ollama / ElloFive upstream for the bridge:
# ELLOFIVE_UPSTREAM=http://127.0.0.1:11434

# Ello5 continuous learning (DigitalOcean worker + HF)
# HF_TOKEN=
# ELLO5_KNOWLEDGE_PATH=data/ello5-learn/knowledge.jsonl
# ELLO5_CHAT_INBOX=data/ello5-learn/inbox/chat.jsonl
# ELLO5_KNOWLEDGE_RELOAD_MS=60000

# CDCI / ChatScan / Central DB (chat turns → blockchain commitments, content PRIVATE)
FEATURE_CHAIN_PERSIST=true
# CHATSCAN_URL=http://127.0.0.1:3000
# CHATSCAN_INGEST_KEY=
# CENTRALDB_URL=http://127.0.0.1:8788
# CENTRALDB_API_KEY=cdb_live_…
NEURIY_CHAIN_ID=neuriy-cdci-local
# CHAIN_TIMEOUT_MS=8000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=neuriyart-com.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=neuriyart-com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=neuriyart-com.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=762094443577
NEXT_PUBLIC_FIREBASE_APP_ID=1:762094443577:web:b1c16194dfe8280a3c41e8
FIREBASE_PROJECT_ID=neuriyart-com

NEURIY_NID_URL=https://id.neuriy.com

# Origins allowed to call ChatBase APIs from Frontend-cms (comma-separated)
# CHATBASE_CORS_ORIGINS=https://neuriy.com,https://www.neuriy.com

# Local testing only — never enable in production. AI requires IDHook login.
# DEV_AUTH_BYPASS=1
# NEXT_PUBLIC_DEV_AUTH_BYPASS=1
